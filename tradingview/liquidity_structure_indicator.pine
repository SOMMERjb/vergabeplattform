//@version=6
// ══════════════════════════════════════════════════════════════════════════════
//  Liquidity → Structure Shift  |  INDICATOR
//  Kette: BoS → EQH/EQL → Sweep (bleibt sichtbar) → FVG → CHoCH → Entry
//  Letzte N Trades werden angezeigt, ältere automatisch gelöscht
// ══════════════════════════════════════════════════════════════════════════════
indicator("Liquidity → Structure Shift [Indicator]",
          overlay          = true,
          max_bars_back    = 500,
          max_lines_count  = 500,
          max_labels_count = 200,
          max_boxes_count  = 60)

// ─── Inputs ───────────────────────────────────────────────────────────────────
swingLen    = input.int   (10,   "Swing Length",           minval=3,    group="Struktur")
minBoS      = input.int   (1,    "Min. BoS vor CHoCH",    minval=1,    group="Struktur")
eqSens      = input.float (0.2,  "Equal H/L Toleranz %",  minval=0.01, step=0.01, group="Liquidität")
minSweepPct = input.float (0.0,  "Min. Sweep-Pierce %",   minval=0.0,  step=0.01, group="Liquidität")
rrRatio     = input.float (2.5,  "Risk/Reward Ratio",     minval=0.5,  step=0.1,  group="Trade")
slBuf       = input.float (0.1,  "SL Puffer %",           minval=0.01, step=0.01, group="Trade")
maxTrades   = input.int   (4,    "Letzte N Trades zeigen",minval=1, maxval=8, group="Anzeige")
showBoS     = input.bool  (true, "BoS Marker",            group="Anzeige")
showCHoCH   = input.bool  (true, "CHoCH Label",           group="Anzeige")
showEQ      = input.bool  (true, "EQH / EQL Linien",      group="Anzeige")
showFVG     = input.bool  (true, "FVG Einstiegszone",     group="Anzeige")
showTrade   = input.bool  (true, "SL / TP Linien",        group="Anzeige")

// ─── Swing Erkennung ──────────────────────────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow (low,  swingLen, swingLen)

var float shVal  = na
var int   shBar  = na
var float shVal2 = na
var int   shBar2 = na
var float slVal  = na
var int   slBar  = na
var float slVal2 = na
var int   slBar2 = na

if not na(ph)
    shVal2 := shVal
    shBar2 := shBar
    shVal  := ph
    shBar  := bar_index[swingLen]

if not na(pl)
    slVal2 := slVal
    slBar2 := slBar
    slVal  := pl
    slBar  := bar_index[swingLen]

// ─── Marktstruktur ────────────────────────────────────────────────────────────
var int   trend        = 0
var float lastBrknHigh = na
var float lastBrknLow  = na
var int   bosUpCount   = 0
var int   bosDownCount = 0

newHighBreak = not na(shVal) and close > shVal and (na(lastBrknHigh) or shVal != lastBrknHigh)
newLowBreak  = not na(slVal) and close < slVal and (na(lastBrknLow)  or slVal != lastBrknLow)

bullBody = close > open
bearBody = close < open

chochUp   = newHighBreak and trend == -1 and bullBody and bosDownCount >= minBoS
chochDown = newLowBreak  and trend ==  1 and bearBody and bosUpCount   >= minBoS
bosUp     = newHighBreak and trend >= 0  and not chochUp
bosDown   = newLowBreak  and trend <= 0  and not chochDown

if chochUp or bosUp
    trend        := 1
    lastBrknHigh := shVal
    bosUpCount   := chochUp ? 0 : bosUpCount + 1
    if chochUp
        bosDownCount := 0

if chochDown or bosDown
    trend         := -1
    lastBrknLow   := slVal
    bosDownCount  := chochDown ? 0 : bosDownCount + 1
    if chochDown
        bosUpCount := 0

// CHoCH Label (wichtigstes Signal, bleibt sichtbar)
if showCHoCH
    if chochUp
        label.new(bar_index, low, "CHoCH",
                  style=label.style_label_up, color=color.new(color.lime, 10),
                  textcolor=color.black, size=size.small)
    if chochDown
        label.new(bar_index, high, "CHoCH",
                  style=label.style_label_down, color=color.new(color.orange, 10),
                  textcolor=color.black, size=size.small)

// ─── Equal Highs / Lows ───────────────────────────────────────────────────────
eqThresh = eqSens / 100.0
isEQH = not na(ph) and not na(shVal) and not na(shVal2) and math.abs(shVal - shVal2) / shVal2 <= eqThresh
isEQL = not na(pl) and not na(slVal) and not na(slVal2) and math.abs(slVal - slVal2) / slVal2 <= eqThresh

// Aktive Linie (noch nicht gesweept) – wird ersetzt wenn neue EQH/EQL entsteht
var float eqHighLvl   = na
var int   eqHighStart = na
var line  eqHighLine  = na
var float eqLowLvl    = na
var int   eqLowStart  = na
var line  eqLowLine   = na

// Gesweepte Linien bleiben sichtbar (begrenzt auf letzte 8)
var line[] sweptHighLines = array.new<line>()
var line[] sweptLowLines  = array.new<line>()
int MAX_SWEPT = 8

if isEQH
    // Nur AKTIVE (nicht gesweepte) Linie ersetzen
    if not na(eqHighLine) and not na(eqHighLvl)
        line.delete(eqHighLine)
        eqHighLine := na
    bool leftIsLower = shVal2 <= shVal
    eqHighLvl   := leftIsLower ? shVal2 : shVal
    eqHighStart := leftIsLower ? shBar2 : shBar
    if showEQ and not na(eqHighStart)
        eqHighLine := line.new(eqHighStart, eqHighLvl, bar_index, eqHighLvl,
                               color=color.new(color.orange, 35), width=1,
                               style=line.style_dashed, extend=extend.right)

if isEQL
    if not na(eqLowLine) and not na(eqLowLvl)
        line.delete(eqLowLine)
        eqLowLine := na
    bool leftIsHigher = slVal2 >= slVal
    eqLowLvl   := leftIsHigher ? slVal2 : slVal
    eqLowStart := leftIsHigher ? slBar2 : slBar
    if showEQ and not na(eqLowStart)
        eqLowLine := line.new(eqLowStart, eqLowLvl, bar_index, eqLowLvl,
                              color=color.new(color.aqua, 35), width=1,
                              style=line.style_dashed, extend=extend.right)

// ─── Liquiditätssweep ─────────────────────────────────────────────────────────
minPierce = minSweepPct / 100.0

var bool  pendingShort   = false
var float pendingShortSL = na
var int   sweepBarShort  = na
var bool  pendingLong    = false
var float pendingLongSL  = na
var int   sweepBarLong   = na

highSwept = not na(eqHighLvl) and trend == 1  and high >= eqHighLvl * (1.0 + minPierce) and close < eqHighLvl
lowSwept  = not na(eqLowLvl)  and trend == -1 and low  <= eqLowLvl  * (1.0 - minPierce) and close > eqLowLvl

if highSwept
    pendingShort   := true
    pendingShortSL := high * (1.0 + slBuf / 100.0)
    sweepBarShort  := bar_index
    eqHighLvl      := na
    // Linie einfrieren + zu gesweepten hinzufügen (bleibt sichtbar)
    if not na(eqHighLine)
        line.set_x2(eqHighLine, bar_index)
        line.set_extend(eqHighLine, extend.none)
        line.set_color(eqHighLine, color.new(color.orange, 0))
        line.set_width(eqHighLine, 2)
        array.push(sweptHighLines, eqHighLine)
        eqHighLine := na
        // Alte gesweepte Linien bereinigen
        while array.size(sweptHighLines) > MAX_SWEPT
            line.delete(array.shift(sweptHighLines))
    if showEQ
        label.new(bar_index, high, "Sweep",
                  style=label.style_label_down, color=color.new(color.orange, 0),
                  textcolor=color.white, size=size.tiny)

if lowSwept
    pendingLong    := true
    pendingLongSL  := low * (1.0 - slBuf / 100.0)
    sweepBarLong   := bar_index
    eqLowLvl       := na
    if not na(eqLowLine)
        line.set_x2(eqLowLine, bar_index)
        line.set_extend(eqLowLine, extend.none)
        line.set_color(eqLowLine, color.new(color.aqua, 0))
        line.set_width(eqLowLine, 2)
        array.push(sweptLowLines, eqLowLine)
        eqLowLine := na
        while array.size(sweptLowLines) > MAX_SWEPT
            line.delete(array.shift(sweptLowLines))
    if showEQ
        label.new(bar_index, low, "Sweep",
                  style=label.style_label_up, color=color.new(color.aqua, 0),
                  textcolor=color.white, size=size.tiny)

// ─── FVG Erkennung ────────────────────────────────────────────────────────────
bearFVG = high < low[2]
bullFVG = low  > high[2]

var float fvgSTop = na
var float fvgSBot = na
var int   fvgSBar = na
var float fvgLBot = na
var float fvgLTop = na
var int   fvgLBar = na

if pendingShort and bearFVG
    fvgSTop := low[2]
    fvgSBot := high
    fvgSBar := bar_index[1]

if pendingLong and bullFVG
    fvgLBot := high[2]
    fvgLTop := low
    fvgLBar := bar_index[1]

// Pending abbrechen wenn Trend gegen Setup dreht
if bosDown and pendingShort
    pendingShort := false
    fvgSTop := na ; fvgSBot := na ; fvgSBar := na

if bosUp and pendingLong
    pendingLong := false
    fvgLBot := na ; fvgLTop := na ; fvgLBar := na

// ─── Signale ──────────────────────────────────────────────────────────────────
shortSig = pendingShort and chochDown
longSig  = pendingLong  and chochUp

// ─── Trade Visualisierung (letzte N Trades, ältere werden gelöscht) ──────────
var box[]   tradeFVGBoxes   = array.new<box>()
var line[]  tradeEntryLines = array.new<line>()
var line[]  tradeSLLines    = array.new<line>()
var line[]  tradeTPLines    = array.new<line>()
var label[] tradeEntryLbls  = array.new<label>()
var label[] tradeSLLbls     = array.new<label>()
var label[] tradeTPLbls     = array.new<label>()

// Älteste Trade-Visualisierungen löschen
cleanupTrades() =>
    while array.size(tradeEntryLines) > maxTrades
        b = array.shift(tradeFVGBoxes)
        if not na(b)
            box.delete(b)
        line.delete(array.shift(tradeEntryLines))
        line.delete(array.shift(tradeSLLines))
        line.delete(array.shift(tradeTPLines))
        label.delete(array.shift(tradeEntryLbls))
        label.delete(array.shift(tradeSLLbls))
        label.delete(array.shift(tradeTPLbls))

extBars = 50

if shortSig
    hasFVG  = not na(fvgSTop) and not na(fvgSBot)
    entryS  = hasFVG ? (fvgSTop + fvgSBot) / 2.0 : close
    sl_s    = na(pendingShortSL) ? high * (1.0 + slBuf / 100.0) : pendingShortSL
    risk    = math.max(sl_s - entryS, entryS * 0.0005)
    tp_s    = entryS - risk * rrRatio
    slFrom  = na(sweepBarShort) ? bar_index : sweepBarShort

    // FVG Box
    newBox = hasFVG and showFVG and not na(fvgSBar) ?
             box.new(fvgSBar - 1, fvgSTop, bar_index + extBars, fvgSBot,
                     bgcolor=color.new(color.red, 88),
                     border_color=color.new(color.red, 50), border_width=1) : na

    // Linien
    eLn = showTrade ? line.new(bar_index, entryS, bar_index + extBars, entryS,
                               color=color.new(color.yellow, 0), width=1) : na
    // SL startet am Sweep-Bar
    sLn = showTrade ? line.new(slFrom, sl_s, bar_index + extBars, sl_s,
                               color=color.new(color.red, 20), width=1,
                               style=line.style_dashed) : na
    tLn = showTrade ? line.new(bar_index, tp_s, bar_index + extBars, tp_s,
                               color=color.new(color.lime, 20), width=1,
                               style=line.style_dashed) : na

    // Labels
    eLbl = showTrade ? label.new(bar_index + extBars, entryS,
                                 hasFVG ? "Entry FVG" : "Entry",
                                 style=label.style_label_left,
                                 color=color.new(color.yellow, 10),
                                 textcolor=color.black, size=size.tiny) : na
    sLbl = showTrade ? label.new(bar_index + extBars, sl_s, "SL",
                                 style=label.style_label_left,
                                 color=color.new(color.red, 10),
                                 textcolor=color.white, size=size.tiny) : na
    tLbl = showTrade ? label.new(bar_index + extBars, tp_s,
                                 str.tostring(rrRatio, "#.#") + "R",
                                 style=label.style_label_left,
                                 color=color.new(color.lime, 10),
                                 textcolor=color.black, size=size.tiny) : na

    array.push(tradeFVGBoxes,   newBox)
    array.push(tradeEntryLines, eLn)
    array.push(tradeSLLines,    sLn)
    array.push(tradeTPLines,    tLn)
    array.push(tradeEntryLbls,  eLbl)
    array.push(tradeSLLbls,     sLbl)
    array.push(tradeTPLbls,     tLbl)
    cleanupTrades()

    pendingShort := false
    fvgSTop := na ; fvgSBot := na ; fvgSBar := na ; sweepBarShort := na

if longSig
    hasFVG  = not na(fvgLBot) and not na(fvgLTop)
    entryL  = hasFVG ? (fvgLBot + fvgLTop) / 2.0 : close
    sl_l    = na(pendingLongSL) ? low * (1.0 - slBuf / 100.0) : pendingLongSL
    risk    = math.max(entryL - sl_l, entryL * 0.0005)
    tp_l    = entryL + risk * rrRatio
    slFrom  = na(sweepBarLong) ? bar_index : sweepBarLong

    newBox = hasFVG and showFVG and not na(fvgLBar) ?
             box.new(fvgLBar - 1, fvgLTop, bar_index + extBars, fvgLBot,
                     bgcolor=color.new(color.green, 88),
                     border_color=color.new(color.green, 50), border_width=1) : na

    eLn = showTrade ? line.new(bar_index, entryL, bar_index + extBars, entryL,
                               color=color.new(color.yellow, 0), width=1) : na
    sLn = showTrade ? line.new(slFrom, sl_l, bar_index + extBars, sl_l,
                               color=color.new(color.red, 20), width=1,
                               style=line.style_dashed) : na
    tLn = showTrade ? line.new(bar_index, tp_l, bar_index + extBars, tp_l,
                               color=color.new(color.lime, 20), width=1,
                               style=line.style_dashed) : na

    eLbl = showTrade ? label.new(bar_index + extBars, entryL,
                                 hasFVG ? "Entry FVG" : "Entry",
                                 style=label.style_label_left,
                                 color=color.new(color.yellow, 10),
                                 textcolor=color.black, size=size.tiny) : na
    sLbl = showTrade ? label.new(bar_index + extBars, sl_l, "SL",
                                 style=label.style_label_left,
                                 color=color.new(color.red, 10),
                                 textcolor=color.white, size=size.tiny) : na
    tLbl = showTrade ? label.new(bar_index + extBars, tp_l,
                                 str.tostring(rrRatio, "#.#") + "R",
                                 style=label.style_label_left,
                                 color=color.new(color.lime, 10),
                                 textcolor=color.black, size=size.tiny) : na

    array.push(tradeFVGBoxes,   newBox)
    array.push(tradeEntryLines, eLn)
    array.push(tradeSLLines,    sLn)
    array.push(tradeTPLines,    tLn)
    array.push(tradeEntryLbls,  eLbl)
    array.push(tradeSLLbls,     sLbl)
    array.push(tradeTPLbls,     tLbl)
    cleanupTrades()

    pendingLong := false
    fvgLBot := na ; fvgLTop := na ; fvgLBar := na ; sweepBarLong := na

// ─── Permanente Marker (nicht in Trade-Arrays) ───────────────────────────────
// BoS: kleiner Pfeil, kein Text → weniger Clutter
plotshape(showBoS and bosUp,   "BoS ▲", shape.triangleup,   location.belowbar,
          color.new(color.teal,   20), size=size.tiny)
plotshape(showBoS and bosDown, "BoS ▼", shape.triangledown, location.abovebar,
          color.new(color.maroon, 20), size=size.tiny)

// Entry Pfeile
plotshape(longSig,  "LONG",  shape.triangleup,   location.belowbar,
          color.new(color.green, 0), size=size.normal)
plotshape(shortSig, "SHORT", shape.triangledown, location.abovebar,
          color.new(color.red,   0), size=size.normal)
