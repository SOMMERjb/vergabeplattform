//@version=6
// ══════════════════════════════════════════════════════════════════════════════
//  Liquidity → Structure Shift  |  INDICATOR
//
//  Einstieg-Logik:
//  1. Trend aufbauen via BoS
//  2. Equal Highs/Lows als Liquiditätszone erkennen (EQH/EQL)
//  3. Sweep: Wick durchsticht die Zone, Close zurück darunter/darüber
//  4. CHoCH: Körper-Break (Kerze schließt in Richtung des Bruchs)
//  5. FVG VOR dem CHoCH → Limit-Einstieg in der Mitte der Imbalance
//  6. SL über Sweep-Wick, TP über R:R-Ratio
// ══════════════════════════════════════════════════════════════════════════════
indicator("Liquidity → Structure Shift [Indicator]",
          overlay          = true,
          max_bars_back    = 500,
          max_lines_count  = 300,
          max_labels_count = 300,
          max_boxes_count  = 100)

// ─── Inputs ───────────────────────────────────────────────────────────────────
swingLen    = input.int   (10,   "Swing Length",           minval=3,    group="Struktur")
minBoS      = input.int   (1,    "Min. BoS vor CHoCH",    minval=1,    group="Struktur")
eqSens      = input.float (0.2,  "Equal H/L Toleranz %",  minval=0.01, step=0.01, group="Liquidität")
minSweepPct = input.float (0.0,  "Min. Sweep-Pierce %",   minval=0.0,  step=0.01, group="Liquidität")
rrRatio     = input.float (2.5,  "Risk/Reward Ratio",     minval=0.5,  step=0.1,  group="Trade")
slBuf       = input.float (0.1,  "SL Puffer %",           minval=0.01, step=0.01, group="Trade")
showBoS     = input.bool  (true, "BoS Labels",            group="Anzeige")
showCHoCH   = input.bool  (true, "CHoCH Labels",          group="Anzeige")
showEQ      = input.bool  (true, "EQH / EQL Linien",      group="Anzeige")
showFVG     = input.bool  (true, "FVG Einstiegszone",     group="Anzeige")
showTrade   = input.bool  (true, "SL / TP Linien",        group="Anzeige")

// ─── Swing Erkennung ──────────────────────────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow (low,  swingLen, swingLen)

var float shVal  = na
var int   shBar  = na
var float shVal2 = na
var int   shBar2 = na
var float slVal  = na
var int   slBar  = na
var float slVal2 = na
var int   slBar2 = na

if not na(ph)
    shVal2 := shVal
    shBar2 := shBar
    shVal  := ph
    shBar  := bar_index[swingLen]

if not na(pl)
    slVal2 := slVal
    slBar2 := slBar
    slVal  := pl
    slBar  := bar_index[swingLen]

plotshape(not na(ph), "Swing H", shape.circle, location.abovebar,
          color.new(color.red,  50), offset=-swingLen, size=size.tiny)
plotshape(not na(pl), "Swing L", shape.circle, location.belowbar,
          color.new(color.teal, 50), offset=-swingLen, size=size.tiny)

// ─── Marktstruktur ────────────────────────────────────────────────────────────
var int   trend        = 0
var float lastBrknHigh = na
var float lastBrknLow  = na
var int   bosUpCount   = 0
var int   bosDownCount = 0

newHighBreak = not na(shVal) and close > shVal and (na(lastBrknHigh) or shVal != lastBrknHigh)
newLowBreak  = not na(slVal) and close < slVal and (na(lastBrknLow)  or slVal != lastBrknLow)

bullBody = close > open
bearBody = close < open

chochUp   = newHighBreak and trend == -1 and bullBody and bosDownCount >= minBoS
chochDown = newLowBreak  and trend ==  1 and bearBody and bosUpCount   >= minBoS
bosUp     = newHighBreak and trend >= 0  and not chochUp
bosDown   = newLowBreak  and trend <= 0  and not chochDown

if chochUp or bosUp
    trend        := 1
    lastBrknHigh := shVal
    bosUpCount   := chochUp ? 0 : bosUpCount + 1
    if chochUp
        bosDownCount := 0

if chochDown or bosDown
    trend         := -1
    lastBrknLow   := slVal
    bosDownCount  := chochDown ? 0 : bosDownCount + 1
    if chochDown
        bosUpCount := 0

if showBoS
    if bosUp
        label.new(bar_index, high, "BoS",
                  style=label.style_label_down, color=color.new(color.teal, 25),
                  textcolor=color.white, size=size.small)
    if bosDown
        label.new(bar_index, low, "BoS",
                  style=label.style_label_up, color=color.new(color.maroon, 25),
                  textcolor=color.white, size=size.small)

if showCHoCH
    if chochUp
        label.new(bar_index, low, "CHoCH",
                  style=label.style_label_up, color=color.new(color.lime, 10),
                  textcolor=color.black, size=size.normal)
    if chochDown
        label.new(bar_index, high, "CHoCH",
                  style=label.style_label_down, color=color.new(color.orange, 10),
                  textcolor=color.black, size=size.normal)

// ─── Equal Highs / Lows ───────────────────────────────────────────────────────
eqThresh = eqSens / 100.0
isEQH = not na(ph) and not na(shVal) and not na(shVal2) and math.abs(shVal - shVal2) / shVal2 <= eqThresh
isEQL = not na(pl) and not na(slVal) and not na(slVal2) and math.abs(slVal - slVal2) / slVal2 <= eqThresh

var float eqHighLvl   = na
var int   eqHighStart = na
var line  eqHighLine  = na
var float eqLowLvl    = na
var int   eqLowStart  = na
var line  eqLowLine   = na

if isEQH
    if not na(eqHighLine)
        line.delete(eqHighLine)
    bool leftIsLower = shVal2 <= shVal
    eqHighLvl   := leftIsLower ? shVal2 : shVal
    eqHighStart := leftIsLower ? shBar2 : shBar
    if showEQ and not na(eqHighStart)
        eqHighLine := line.new(eqHighStart, eqHighLvl, bar_index, eqHighLvl,
                               color=color.new(color.orange, 30), width=1,
                               style=line.style_dashed, extend=extend.right)
        label.new(eqHighStart, eqHighLvl, "EQH",
                  style=label.style_label_right, color=color.new(color.orange, 20),
                  textcolor=color.white, size=size.tiny)

if isEQL
    if not na(eqLowLine)
        line.delete(eqLowLine)
    bool leftIsHigher = slVal2 >= slVal
    eqLowLvl   := leftIsHigher ? slVal2 : slVal
    eqLowStart := leftIsHigher ? slBar2 : slBar
    if showEQ and not na(eqLowStart)
        eqLowLine := line.new(eqLowStart, eqLowLvl, bar_index, eqLowLvl,
                              color=color.new(color.aqua, 30), width=1,
                              style=line.style_dashed, extend=extend.right)
        label.new(eqLowStart, eqLowLvl, "EQL",
                  style=label.style_label_right, color=color.new(color.aqua, 20),
                  textcolor=color.white, size=size.tiny)

// ─── Liquiditätssweep ─────────────────────────────────────────────────────────
minPierce = minSweepPct / 100.0

var bool  pendingShort   = false
var float pendingShortSL = na
var bool  pendingLong    = false
var float pendingLongSL  = na

highSwept = not na(eqHighLvl) and trend == 1  and high >= eqHighLvl * (1.0 + minPierce) and close < eqHighLvl
lowSwept  = not na(eqLowLvl)  and trend == -1 and low  <= eqLowLvl  * (1.0 - minPierce) and close > eqLowLvl

if highSwept
    pendingShort   := true
    pendingShortSL := high * (1.0 + slBuf / 100.0)
    eqHighLvl      := na
    if not na(eqHighLine)
        line.set_x2(eqHighLine, bar_index)
        line.set_extend(eqHighLine, extend.none)
        line.set_color(eqHighLine, color.new(color.orange, 0))
    if showEQ
        label.new(bar_index, high, "Sweep",
                  style=label.style_label_down, color=color.new(color.orange, 0),
                  textcolor=color.white, size=size.tiny)

if lowSwept
    pendingLong    := true
    pendingLongSL  := low * (1.0 - slBuf / 100.0)
    eqLowLvl       := na
    if not na(eqLowLine)
        line.set_x2(eqLowLine, bar_index)
        line.set_extend(eqLowLine, extend.none)
        line.set_color(eqLowLine, color.new(color.aqua, 0))
    if showEQ
        label.new(bar_index, low, "Sweep",
                  style=label.style_label_up, color=color.new(color.aqua, 0),
                  textcolor=color.white, size=size.tiny)

// ─── FVG Erkennung (Fair Value Gap) ───────────────────────────────────────────
// Bärische FVG: Kerze[0].high < Kerze[2].low  →  Imbalance zwischen high und low[2]
// Bullische FVG: Kerze[0].low > Kerze[2].high →  Imbalance zwischen high[2] und low
bearFVG = high < low[2]
bullFVG = low  > high[2]

// Jeweils die aktuellste FVG nach dem Sweep verfolgen
var float fvgSTop = na   // Short: oberes Ende der bärischen FVG
var float fvgSBot = na   //        unteres Ende
var int   fvgSBar = na   //        Bar-Index (Mitte des 3-Kerzen-Musters)
var float fvgLBot = na   // Long:  unteres Ende der bullischen FVG
var float fvgLTop = na
var int   fvgLBar = na

if pendingShort and bearFVG
    fvgSTop := low[2]
    fvgSBot := high
    fvgSBar := bar_index[1]

if pendingLong and bullFVG
    fvgLBot := high[2]
    fvgLTop := low
    fvgLBar := bar_index[1]

// Pending löschen wenn Trendstruktur gegen Setup dreht
if bosDown and pendingShort
    pendingShort := false
    fvgSTop := na
    fvgSBot := na
    fvgSBar := na

if bosUp and pendingLong
    pendingLong := false
    fvgLBot := na
    fvgLTop := na
    fvgLBar := na

// ─── Einstiegssignale ─────────────────────────────────────────────────────────
shortSig = pendingShort and chochDown
longSig  = pendingLong  and chochUp

// ─── Entry Arrows ─────────────────────────────────────────────────────────────
plotshape(longSig,  "LONG",  shape.triangleup,   location.belowbar,
          color.new(color.green, 0), size=size.large)
plotshape(shortSig, "SHORT", shape.triangledown, location.abovebar,
          color.new(color.red,   0), size=size.large)

// ─── Trade-Visualisierung mit FVG-Einstieg ───────────────────────────────────
extBars = 40

if shortSig
    hasFVG   = not na(fvgSTop) and not na(fvgSBot)
    entryS   = hasFVG ? (fvgSTop + fvgSBot) / 2.0 : close
    sl_s     = na(pendingShortSL) ? high * (1.0 + slBuf / 100.0) : pendingShortSL
    risk     = math.max(sl_s - entryS, entryS * 0.0005)
    tp_s     = entryS - risk * rrRatio

    // FVG-Box zeichnen
    if showFVG and hasFVG and not na(fvgSBar)
        box.new(fvgSBar - 1, fvgSTop, bar_index + extBars, fvgSBot,
                bgcolor      = color.new(color.red, 88),
                border_color = color.new(color.red, 40),
                border_width = 1)
        label.new(fvgSBar - 1, fvgSTop, "FVG",
                  style=label.style_label_right,
                  color=color.new(color.red, 30), textcolor=color.white, size=size.tiny)

    if showTrade
        line.new(bar_index, entryS, bar_index + extBars, entryS,
                 color=color.new(color.yellow, 0), width=1)
        line.new(bar_index, sl_s,   bar_index + extBars, sl_s,
                 color=color.new(color.red,  20), width=1, style=line.style_dashed)
        line.new(bar_index, tp_s,   bar_index + extBars, tp_s,
                 color=color.new(color.lime, 20), width=1, style=line.style_dashed)
        label.new(bar_index + extBars, sl_s, "SL",
                  style=label.style_label_left, color=color.new(color.red,  10),
                  textcolor=color.white, size=size.tiny)
        label.new(bar_index + extBars, tp_s, str.tostring(rrRatio, "#.#") + "R",
                  style=label.style_label_left, color=color.new(color.lime, 10),
                  textcolor=color.black, size=size.tiny)
        label.new(bar_index + extBars, entryS,
                  hasFVG ? "Entry FVG" : "Entry",
                  style=label.style_label_left, color=color.new(color.yellow, 10),
                  textcolor=color.black, size=size.tiny)

    pendingShort := false
    fvgSTop := na
    fvgSBot := na
    fvgSBar := na

if longSig
    hasFVG   = not na(fvgLBot) and not na(fvgLTop)
    entryL   = hasFVG ? (fvgLBot + fvgLTop) / 2.0 : close
    sl_l     = na(pendingLongSL) ? low * (1.0 - slBuf / 100.0) : pendingLongSL
    risk     = math.max(entryL - sl_l, entryL * 0.0005)
    tp_l     = entryL + risk * rrRatio

    // FVG-Box zeichnen
    if showFVG and hasFVG and not na(fvgLBar)
        box.new(fvgLBar - 1, fvgLTop, bar_index + extBars, fvgLBot,
                bgcolor      = color.new(color.green, 88),
                border_color = color.new(color.green, 40),
                border_width = 1)
        label.new(fvgLBar - 1, fvgLBot, "FVG",
                  style=label.style_label_right,
                  color=color.new(color.green, 30), textcolor=color.white, size=size.tiny)

    if showTrade
        line.new(bar_index, entryL, bar_index + extBars, entryL,
                 color=color.new(color.yellow, 0), width=1)
        line.new(bar_index, sl_l,   bar_index + extBars, sl_l,
                 color=color.new(color.red,  20), width=1, style=line.style_dashed)
        line.new(bar_index, tp_l,   bar_index + extBars, tp_l,
                 color=color.new(color.lime, 20), width=1, style=line.style_dashed)
        label.new(bar_index + extBars, sl_l, "SL",
                  style=label.style_label_left, color=color.new(color.red,  10),
                  textcolor=color.white, size=size.tiny)
        label.new(bar_index + extBars, tp_l, str.tostring(rrRatio, "#.#") + "R",
                  style=label.style_label_left, color=color.new(color.lime, 10),
                  textcolor=color.black, size=size.tiny)
        label.new(bar_index + extBars, entryL,
                  hasFVG ? "Entry FVG" : "Entry",
                  style=label.style_label_left, color=color.new(color.yellow, 10),
                  textcolor=color.black, size=size.tiny)

    pendingLong := false
    fvgLBot := na
    fvgLTop := na
    fvgLBar := na
